# === Core ===
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
DEBUG=false
ENVIRONMENT=production
ALLOWED_HOSTS=localhost,127.0.0.1

# === Hybrid local app + Docker services ===
DATABASE_URL=postgresql+asyncpg://agent:agentpass@localhost:5432/social_agent
SYNC_DATABASE_URL=postgresql://agent:agentpass@localhost:5432/social_agent

# === Redis ===
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# === Kafka ===
KAFKA_BOOTSTRAP_SERVERS=localhost:29092

# === Elasticsearch ===
ELASTICSEARCH_URL=http://localhost:9200

# === AI APIs ===
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# === Social Platforms ===
INSTAGRAM_ACCESS_TOKEN=your-instagram-token
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
INSTAGRAM_REDIRECT_URI=your-public-backend-url/api/auth/instagram/callback

TIKTOK_ACCESS_TOKEN=your-tiktok-token
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret

LINKEDIN_ACCESS_TOKEN=your-linkedin-token
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

FACEBOOK_ACCESS_TOKEN=your-facebook-token
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_REDIRECT_URI=your-public-backend-url/api/auth/facebook/callback

THREADS_APP_ID=your-threads-app-id
THREADS_APP_SECRET=your-threads-app-secret
THREADS_REDIRECT_URI=your-public-backend-url/api/auth/threads/callback

YOUTUBE_CLIENT_ID=your-youtube-client-id
YOUTUBE_CLIENT_SECRET=your-youtube-client-secret
YOUTUBE_REDIRECT_URI=your-public-backend-url/auth/youtube/callback

PUBLIC_API_BASE_URL=your-public-backend-url

# === Storage ===
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=social-agent-media

# === Notifications ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
ALERT_EMAIL=admin@yourcompany.com

# === Security ===
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# === Feature Flags ===
ENABLE_AUTO_POSTING=true
ENABLE_AUTO_REPLY=false
ENABLE_CRISIS_ALERTS=true
CRISIS_NEGATIVE_THRESHOLD=0.4
CRISIS_VOLUME_MULTIPLIER=3.0
