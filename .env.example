# === Core ===
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
DEBUG=false
ENVIRONMENT=production
ALLOWED_HOSTS=localhost,127.0.0.1

# === Database ===
DATABASE_URL=postgresql+asyncpg://agent:agentpass@localhost:5432/social_agent
SYNC_DATABASE_URL=postgresql://agent:agentpass@localhost:5432/social_agent

# === Redis ===
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2


# === Elasticsearch ===
ELASTICSEARCH_URL=http://localhost:9200

# === AI APIs ===
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
HUGGING_FACE_API=your-hugging-face-api-token-here


# === Social Platforms ===
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=

# TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
FACEBOOK_REDIRECT_URI=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=


# Threads
# Threads API 
THREADS_APP_ID=
THREADS_APP_SECRET=

# Redirect URI (doit correspondre à ce que tu as configuré dans l'app)
THREADS_REDIRECT_URI=

# Pinterest
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_REDIRECT_URI=
PINTEREST_ACCESS_TOKEN=

# YOUTUBE
YOUTUBE_CLIENT_ID=
YOUTUBE_REDIRECT_URI=
# ── Twitter / X API ────────────────────────────────────────────

# OAuth 1.0a (obligatoire pour upload média)
TWITTER_API_KEY=
TWITTER_API_SECRET_KEY=
TWITTER_BEARER_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# OAuth 2.0 (pour login utilisateur)
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_ACCESS_TOKEN_V2=
TWITTER_REFRESH_TOKEN=
# Callback
TWITTER_REDIRECT_URI=

# === Storage ===
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=social-agent-media

# === Notifications ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
ALERT_EMAIL=admin@yourcompany.com

# === Security ===
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# === Feature Flags ===
ENABLE_AUTO_POSTING=true
ENABLE_AUTO_REPLY=false
ENABLE_CRISIS_ALERTS=true
CRISIS_NEGATIVE_THRESHOLD=0.4
CRISIS_VOLUME_MULTIPLIER=3.0
